# Required
WATCH_NAME=Your Full Name
WATCH_CONTEXT=company,city,profession
MONITOR_TOKEN=replace-with-a-long-random-secret

# Maritime injects OPENAI_API_KEY when "Use Maritime LLM" is selected.
# Do not paste an OpenAI, Anthropic, or OpenRouter key.
MARITIME_LLM_MODEL=gpt-4o-mini

# Safe usage ceilings. The app rejects values above its built-in maximums.
MAX_ANALYSES_PER_DAY=8
MAX_NEW_PER_RUN=10
CHECKS_PER_DAY=24

# Optional identity tuning
WATCH_ALIASES=
EXCLUDE_TERMS=
REQUIRE_CONTEXT=false

# Optional custom RSS feeds (up to five). If omitted, Google News RSS is used.
RSS_URL_1=
RSS_URL_2=
RSS_URL_3=

# Optional notification: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional notification: generic JSON webhook receiving {"text": "...", "mention": {...}}
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Runtime
PORT=8787
STATE_PATH=./data/state.json
AUTO_RUN=true
